rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function hasUserData() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserRole() {
      return hasUserData() ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role : '';
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'admin@tma.uz' ||
        request.auth.token.email == 'shohdonar@gmail.com' ||
        (hasUserData() && getUserRole() == 'SUPER_ADMIN')
      );
    }

    function isPracticeHead() {
      return isSignedIn() && (
        isSuperAdmin() ||
        (hasUserData() && getUserRole() == 'PRACTICE_HEAD')
      );
    }

    function isPracticeStaff() {
      return isSignedIn() && (
        isPracticeHead() ||
        (hasUserData() && getUserRole() == 'PRACTICE_STAFF')
      );
    }

    function isFacultyDean(facultyId) {
      return isSignedIn() && (isPracticeStaff() || (getUserRole() == 'FACULTY_DEAN' && getUserData().facultyId == facultyId));
    }

    function isSupervisor() {
      return isSignedIn() && (isPracticeStaff() || getUserRole() == 'PRACTICE_SUPERVISOR');
    }

    function isClinicResponsible(placeId) {
      return isSignedIn() && (isPracticeStaff() || (getUserRole() == 'CLINIC_RESPONSIBLE' && getUserData().practicePlaceId == placeId));
    }

    function isStudentOwner(studentUserId) {
      return isSignedIn() && request.auth.uid == studentUserId;
    }

    // --- USERS COLLECTION ---
    match /users/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId ||
        isPracticeStaff()
      );
      // Practice Head and Super Admin can provision staff, supervisors, deans, clinic responsibles.
      // Self-registration is strictly restricted to STUDENT role and matching UID.
      allow create: if isSignedIn() && (
        (request.auth.uid == userId && request.resource.data.role == 'STUDENT') ||
        isPracticeHead()
      );
      allow update: if isSuperAdmin() || (
        isSignedIn() && request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'uid'])
      );
      allow delete: if isSuperAdmin();
    }

    // --- STUDENTS COLLECTION ---
    match /students/{studentId} {
      allow read: if isSignedIn() && (
        isPracticeStaff() ||
        isSupervisor() ||
        resource.data.userId == request.auth.uid ||
        (getUserRole() == 'FACULTY_DEAN' && getUserData().facultyId == resource.data.facultyId) ||
        (getUserRole() == 'CLINIC_RESPONSIBLE' && getUserData().practicePlaceId == resource.data.currentPracticePlaceId)
      );
      allow create, update: if isPracticeStaff();
      allow delete: if isPracticeHead();
    }

    // --- SYSTEM COUNTERS (CONCURRENCY-SAFE STUDENT LOGIN COUNTER) ---
    match /systemCounters/{counterId} {
      // Any authenticated user can read counter
      allow read: if isSignedIn();
      // Only Practice Staff, Practice Head, or Super Admin can create the counter
      allow create: if isPracticeStaff() &&
        request.resource.data.type == 'STUDENT_LOGIN_COUNTER' &&
        request.resource.data.lastIssuedNumber is int &&
        request.resource.data.lastIssuedNumber >= 0;
      // Counter must strictly increment (new > old). It cannot be decreased, reset, or altered arbitrarily!
      allow update: if isPracticeStaff() &&
        request.resource.data.lastIssuedNumber is int &&
        request.resource.data.lastIssuedNumber > resource.data.lastIssuedNumber &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['type']);
      // Counter cannot be deleted under any circumstances!
      allow delete: if false;
    }

    // --- ACADEMIC STRUCTURE (Faculties, Directions, Courses, Groups) ---
    match /academicYears/{yearId} {
      allow read: if isSignedIn();
      allow write: if isPracticeHead();
    }
    match /faculties/{facultyId} {
      allow read: if isSignedIn();
      allow write: if isPracticeHead();
    }

    match /directions/{directionId} {
      allow read: if isSignedIn();
      allow write: if isPracticeHead();
    }

    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow write: if isPracticeHead();
    }

    match /groups/{groupId} {
      allow read: if isSignedIn();
      allow write: if isPracticeStaff();
    }

    // --- CLINICAL PLACES & DEPARTMENTS ---
    match /organizations/{placeId} {
      allow read: if isSignedIn();
      allow write: if isPracticeStaff();
    }

    match /organizationDepartments/{deptId} {
      allow read: if isSignedIn();
      allow write: if isPracticeStaff();
    }

    // --- SUPERVISORS & CLINIC RESPONSIBLES ---
    match /supervisors/{supervisorId} {
      allow read: if isSignedIn();
      allow write: if isPracticeStaff();
    }

    match /clinicResponsibles/{responsibleId} {
      allow read: if isSignedIn();
      allow write: if isPracticeStaff();
    }

    // --- PRACTICES ---
    match /practices/{practiceId} {
      allow read: if isSignedIn();
      allow create, update: if isPracticeStaff();
      allow delete: if isPracticeHead();
    }

    // --- PRACTICE ASSIGNMENTS ---
    match /practiceAssignments/{assignmentId} {
      allow read: if isSignedIn() && (
        isPracticeStaff() ||
        (isSupervisor() && resource.data.supervisorId == get(/databases/$(database)/documents/supervisors/$(request.auth.uid)).data.id) ||
        resource.data.studentId == getUserData().studentId ||
        (getUserRole() == 'CLINIC_RESPONSIBLE' && getUserData().practicePlaceId == resource.data.practicePlaceId)
      );
      allow create, update, delete: if isPracticeStaff();
    }

    // --- ATTENDANCE ---
    match /attendance/{attendanceId} {
      allow read: if isSignedIn() && (
        isPracticeStaff() ||
        isSupervisor() ||
        resource.data.studentId == getUserData().studentId ||
        (getUserRole() == 'CLINIC_RESPONSIBLE' && getUserData().practicePlaceId == resource.data.organizationId)
      );
      // Student can create their own attendance record (e.g. check-in via QR)
      allow create: if isSignedIn() && (
        isPracticeStaff() ||
        isSupervisor() ||
        getUserRole() == 'CLINIC_RESPONSIBLE' ||
        (getUserRole() == 'STUDENT' && request.resource.data.studentId == getUserData().studentId)
      );
      // Practice staff can update attendance.
      // Student can ONLY update their own existing record and CANNOT alter the studentId.
      // Head/Admin can approve exceptions.
      allow update: if isSignedIn() && (
        (isPracticeStaff() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'approvalType'])) ||
        (isPracticeHead() && request.resource.data.status in ['PRESENT', 'ABSENT', 'EXCUSED']) ||
        (
          getUserRole() == 'STUDENT' &&
          resource.data.studentId == getUserData().studentId &&
          request.resource.data.studentId == resource.data.studentId &&
          resource.data.status == 'BLOCKED'
        )
      );
      allow delete: if isPracticeHead();
    }

    // --- ATTENDANCE SESSIONS (QR ATTENDANCE) ---
    match /attendanceSessions/{sessionId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (
        isPracticeStaff() ||
        getUserRole() == 'CLINIC_RESPONSIBLE' ||
        isSupervisor()
      );
      allow delete: if isPracticeHead();
    }

    // --- DAILY JOURNALS ---
    match /dailyJournals/{journalId} {
      allow read: if isSignedIn() && (
        isPracticeStaff() ||
        (isSupervisor() && resource.data.supervisorId == get(/databases/$(database)/documents/supervisors/$(request.auth.uid)).data.id) ||
        resource.data.studentId == getUserData().studentId
      );
      // Student can create new journal in DRAFT or SUBMITTED status
      allow create: if isSignedIn() && (
        isPracticeStaff() ||
        (
          getUserRole() == 'STUDENT' &&
          request.resource.data.studentId == getUserData().studentId &&
          request.resource.data.status in ['DRAFT', 'SUBMITTED', 'OPEN', 'PENDING']
        )
      );
      // Strict State-Machine Transitions:
      // 1. Practice Head / Super Admin can Final Approve, Lock, or Emergency Reopen
      // 2. If already LOCKED or FINAL_APPROVED: All non-admin/head updates are BLOCKED!
      // 3. Supervisor can ONLY transition SUBMITTED -> SUPERVISOR_APPROVED, FINAL_PENDING, or REVISION
      // 4. Student can ONLY update when in DRAFT, OPEN, or REVISION, transitioning to DRAFT or SUBMITTED
      allow update: if isSignedIn() && (
        (isPracticeHead() && (
          request.resource.data.status in ['FINAL_APPROVED', 'LOCKED', 'SUBMITTED', 'REOPENED_BY_DEPARTMENT_HEAD', 'REOPENED_BY_SUPER_ADMIN']
        )) ||
        (!(resource.data.status in ['LOCKED', 'FINAL_APPROVED']) && (
          isPracticeStaff() ||
          (
            isSupervisor() &&
            resource.data.supervisorId == get(/databases/$(database)/documents/supervisors/$(request.auth.uid)).data.id &&
            resource.data.status in ['SUBMITTED', 'SUBMITTED_TO_SUPERVISOR', 'PENDING', 'OPEN'] &&
            request.resource.data.status in ['SUPERVISOR_APPROVED', 'APPROVED_BY_SUPERVISOR', 'FINAL_PENDING', 'REVISION', 'RETURNED_FOR_EDIT'] &&
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['studentId', 'practiceId', 'assignmentId', 'date', 'attendanceId'])
          ) ||
          (
            getUserRole() == 'STUDENT' &&
            resource.data.studentId == getUserData().studentId &&
            request.resource.data.studentId == resource.data.studentId &&
            resource.data.status in ['DRAFT', 'OPEN', 'REVISION', 'RETURNED_FOR_EDIT'] &&
            request.resource.data.status in ['DRAFT', 'SUBMITTED'] &&
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['studentId', 'practiceId', 'assignmentId', 'supervisorId', 'attendanceId', 'isLocked', 'finalApprovedAt', 'finalApprovedBy'])
          )
        ))
      );
      allow delete: if isPracticeHead();
    }

    // --- SKILLS & STUDENT SKILLS ---
    match /skills/{skillId} {
      allow read: if isSignedIn();
      allow write: if isPracticeStaff();
    }

    match /studentSkills/{studentSkillId} {
      allow read: if isSignedIn() && (
        isPracticeStaff() ||
        isSupervisor() ||
        resource.data.studentId == getUserData().studentId ||
        (getUserRole() == 'FACULTY_DEAN') ||
        (getUserRole() == 'CLINIC_RESPONSIBLE')
      );
      allow create: if isSignedIn() && (
        isPracticeStaff() ||
        isSupervisor() ||
        (getUserRole() == 'STUDENT' && request.resource.data.studentId == getUserData().studentId)
      );
      // Student can ONLY update their own skill record and CANNOT alter the studentId.
      allow update: if isSignedIn() && (
        isPracticeStaff() ||
        isSupervisor() ||
        (
          getUserRole() == 'STUDENT' &&
          resource.data.studentId == getUserData().studentId &&
          request.resource.data.studentId == resource.data.studentId
        )
      );
      allow delete: if isPracticeHead();
    }

    match /skillRecords/{recordId} {
      allow read: if isSignedIn() && (
        isPracticeStaff() ||
        isSupervisor() ||
        resource.data.studentId == getUserData().studentId ||
        getUserRole() == 'CLINIC_RESPONSIBLE' ||
        getUserRole() == 'FACULTY_DEAN'
      );
      allow create: if isSignedIn() && (
        isPracticeStaff() ||
        isSupervisor() ||
        (getUserRole() == 'STUDENT' && request.resource.data.studentId == getUserData().studentId)
      );
      allow update: if isSignedIn() && (
        isPracticeStaff() ||
        isSupervisor() ||
        getUserRole() == 'CLINIC_RESPONSIBLE' ||
        (
          getUserRole() == 'STUDENT' &&
          resource.data.studentId == getUserData().studentId &&
          request.resource.data.studentId == resource.data.studentId &&
          resource.data.status in ['PENDING', 'PENDING_REVIEW', 'REVISION']
        )
      );
      allow delete: if isPracticeHead();
    }

    // --- TASKS ---
    match /tasks/{taskId} {
      allow read: if isSignedIn();
      allow write: if isPracticeStaff() || isSupervisor();
    }

    // --- ASSESSMENTS & ATTESTATION ---
    match /assessments/{assessmentId} {
      allow read: if isSignedIn() && (
        isPracticeStaff() ||
        isSupervisor() ||
        getUserRole() == 'FACULTY_DEAN' ||
        resource.data.studentId == getUserData().studentId
      );
      allow create, update: if isPracticeStaff() || isSupervisor();
      allow delete: if isPracticeHead();
    }

    match /finalExams/{examId} {
      allow read: if isSignedIn() && (
        isPracticeStaff() ||
        isSupervisor() ||
        getUserRole() == 'FACULTY_DEAN' ||
        resource.data.studentId == getUserData().studentId
      );
      allow create, update: if isPracticeStaff() || isSupervisor();
      allow delete: if isPracticeHead();
    }

    match /attestationCommissions/{commissionId} {
      allow read: if isSignedIn();
      allow write: if isPracticeStaff();
    }

    match /assessmentSettings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isPracticeHead();
    }

    // --- VEDOMOSTS ---
    match /vedomosts/{vedomostId} {
      allow read: if isSignedIn() && (
        isPracticeStaff() ||
        isSupervisor() ||
        getUserRole() == 'FACULTY_DEAN' ||
        resource.data.students.hasAny([getUserData().studentId])
      );
      allow create: if isPracticeHead();
      allow update: if isPracticeStaff() || isSupervisor() || getUserRole() == 'FACULTY_DEAN';
      allow delete: if isSuperAdmin();
    }

    // --- DOCUMENTS ---
    match /documents/{docId} {
      allow read: if isSignedIn();
      allow write: if isPracticeStaff();
    }

    // --- NOTIFICATIONS ---
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (
        resource.data.recipientUserId == request.auth.uid ||
        resource.data.recipientRole == getUserRole() ||
        isPracticeHead()
      );
      allow create: if isPracticeStaff();
      allow update: if isSignedIn() && (
        resource.data.recipientUserId == request.auth.uid ||
        isPracticeHead()
      );
      allow delete: if isPracticeHead();
    }

    // --- AUDIT LOGS (Immutable, Append-Only) ---
    match /auditLogs/{logId} {
      allow read: if isPracticeHead();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }
  }
}
